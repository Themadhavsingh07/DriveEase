# ==============================================================================
# DriveEase Backend Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# Never commit real secrets to version control.

# Server & Runtime Configuration
PORT=5001
NODE_ENV=production
CLIENT_URL=https://driveease.vercel.app

# Database Connection (PostgreSQL with Connection Pooling)
# For Render / Supabase / Neon / AWS RDS:
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>?connection_limit=10&pool_timeout=20&sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/driveease?connection_limit=10&pool_timeout=20

# JWT Authentication & Cryptographic Secrets (Minimum 32 random characters in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super_strong_jwt_fallback_secret_32chars_min
JWT_ACCESS_SECRET=super_strong_jwt_access_secret_32chars_min
JWT_REFRESH_SECRET=super_strong_jwt_refresh_secret_32chars_min
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
COOKIE_SECRET=super_strong_cookie_signing_secret_32chars_min

# Initial Administrator Seed Credentials (Used only on initial prisma seed)
SEED_ADMIN_EMAIL=admin@driveease.com
SEED_ADMIN_PASSWORD=SecureAdminPassword2026!

# Razorpay Payment Gateway Integration
# Test mode key prefix: rzp_test_ | Live mode key prefix: rzp_live_
RAZORPAY_KEY_ID=rzp_test_DriveEaseTestKey123
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Transactional Email (SMTP / SendGrid / Postmark / Amazon SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_api_key_or_password
EMAIL_FROM="DriveEase Concierge <no-reply@driveease.com>"

# Business & Booking Rules
BUSINESS_TIMEZONE=Asia/Kolkata
BOOKING_HOLD_MINUTES=10
TURNAROUND_BUFFER_MINUTES=0
TAX_RATE=0.18
CANCELLATION_FREE_WINDOW_HOURS=24
CANCELLATION_LATE_FEE_PERCENTAGE=20
