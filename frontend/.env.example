# ==============================================================================
# DriveEase Frontend Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.production or set in Vercel / Netlify dashboard.

# Backend API Base URL
# In production, set to your deployed backend URL, e.g.: https://driveease-api.onrender.com/api
# In local development, leave empty or set to http://localhost:5001/api (Vite proxies /api to port 5001)
VITE_API_URL=https://driveease-api.onrender.com/api

# Razorpay Client Key ID (Safe to expose in frontend; corresponds to RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID=rzp_test_DriveEaseTestKey123
